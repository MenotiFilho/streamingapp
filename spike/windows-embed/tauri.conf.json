{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spike-embed",
  "version": "0.0.1",
  "identifier": "dev.streamingapp.spikeembed",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "spike-embed",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
